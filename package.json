{
  "name": "khmerx-licensed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/local-e2e/start.mjs",
    "migrate:local": "node --experimental-strip-types scripts/local-e2e/migrate.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "miniflare": "4.20260730.0",
    "next": "16.4.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "@vitejs/plugin-react": "6.0.2",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "undici": "7.30.1",
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.9",
    "baseline-browser-mapping": "2.11.28"
  }
